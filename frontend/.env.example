# ═══════════════════════════════════════════════════════════════════════════════
# Dentzy Frontend — Environment Variables
# Copy this file to .env.local and fill in your real values.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────────────────────────
# Set this to your deployed backend URL (e.g. https://dentzy-api.onrender.com)
# Leave unset for local development (defaults to http://localhost:5000)
# NEXT_PUBLIC_API_URL=https://your-backend-url.onrender.com

# ── Google reCAPTCHA v3 ───────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here

